# Copy to .env and fill in. This file is never committed — .env is gitignored.

# The camera's address on your LAN (from the Tapo app: Network Settings).
CAMERA_IP=192.168.1.x

# Tapo camera account. Create it in the Tapo app:
#   Device Settings -> Advanced Settings -> Camera Account
# This is NOT your TP-Link cloud login.
CAMERA_USER=changeme
CAMERA_PASS=changeme

# Cloudflare Tunnel token, from the Zero Trust dashboard when you create
# the tunnel. Treat it like a password — it is a route into this network.
TUNNEL_TOKEN=changeme
